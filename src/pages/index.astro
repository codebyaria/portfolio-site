---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnologyStrip from '../components/TechnologyStrip.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import EngineeringApproach from '../components/EngineeringApproach.astro';
import ProductionExperience from '../components/ProductionExperience.astro';
import { absoluteUrl } from '../lib/site.js';

const siteOrigin = import.meta.env.SITE_ORIGIN ?? 'https://example.com';
const homeUrl = absoluteUrl('/', siteOrigin);
---

<BaseLayout
  title="Aria Nurhadi Zain"
  description="Full Stack Developer with real production experience and a portfolio of full-stack web, content-platform, SEO, and automation work."
  canonical={homeUrl}
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__content">
      <p class="hero__eyebrow label">Aria Nurhadi Zain · Full-stack Web Developer</p>
      <h1 id="hero-title" class="hero__title">Full Stack Developer</h1>
      <p class="hero__subheadline">
        Fast, SEO-driven websites, content platforms, and automation systems.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/work/">View selected work</a>
        <a class="button button--secondary" href="https://github.com/codebyaria" rel="me">
          GitHub ↗
        </a>
      </div>
    </div>
    <figure class="hero__portrait">
      <picture>
        <source srcset="/images/aria-portrait.webp" type="image/webp" />
        <img
          src="/images/aria-portrait.png"
          alt="Aria Nurhadi Zain"
          width="800"
          height="1200"
          loading="eager"
          decoding="async"
        />
      </picture>
    </figure>
  </section>

  <TechnologyStrip />

  <section class="status-bar container" aria-label="Current state">
    <dl>
      <div>
        <dt class="label">Full-time</dt>
        <dd>Open to full-time remote employment.</dd>
      </div>
      <div>
        <dt class="label">Based</dt>
        <dd>Sukoharjo, Central Java, Indonesia.</dd>
      </div>
      <div>
        <dt class="label">English</dt>
        <dd>Conversational, not yet fluent.</dd>
      </div>
      <div>
        <dt class="label">In development</dt>
        <dd>Local Business Growth demo · AI SEO pipeline · SEO dashboard</dd>
      </div>
    </dl>
  </section>

  <CapabilityGrid />

  <EngineeringApproach />

  <ProductionExperience />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 7rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  @media (min-width: 720px) {
    .hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
  .hero__content {
    display: grid;
    gap: var(--space-md);
  }
  .hero__portrait {
    margin: 0;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 4px;
    max-width: 360px;
    justify-self: center;
    background: var(--ink);
  }
  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    max-width: 14ch;
  }
  .hero__subheadline {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.35;
    color: var(--ink);
    font-weight: 500;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__status {
    margin: 0;
    color: var(--caution);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.25rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  .button--primary {
    background: var(--ink);
    color: var(--inverse);
  }
  .button--secondary {
    background: var(--paper);
  }
  .button--primary:hover,
  .button--primary:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
  }
  .status-bar {
    padding-block: var(--space-xl);
  }
  .status-bar dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-lg);
  }
  .status-bar dt {
    color: var(--soft-ink);
    margin-bottom: 0.25rem;
  }
  .status-bar dd {
    margin: 0;
    font-weight: 600;
  }
  @media (max-width: 580px) {
    .hero {
      padding-block: var(--space-2xl);
    }
  }
</style>
