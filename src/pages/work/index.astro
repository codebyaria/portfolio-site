---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const all = await getCollection('work');

type Group = {
  id: string;
  label: string;
  intro: string;
  items: typeof all;
};
const bySlug = new Map(all.map((entry) => [entry.data.slug, entry]));

const pick = (slugs: string[]) =>
  slugs.map((slug) => bySlug.get(slug)).filter(Boolean) as typeof all;

const featuredItems = pick([
  'local-business-growth',
  'ai-seo-content-pipeline',
  'seo-intelligence-dashboard',
]);
const earlierItems = pick(['early-laravel-web-projects']);
const workplaceItems = pick([
  'merdeka-ai',
  'object-expression-sdn-bhd',
  'hasnur-centre',
  'nongsa-sez',
]);
const recurringItems = pick([
  'wordpress-client-work',
  'analytics-integrations',
  'security-performance-backup',
  'n8n-automations',
]);

const groups: Group[] = [
  {
    id: 'featured',
    label: 'Featured projects',
    intro: 'Project-level examples across modern web, CMS/API, automation, and dashboard work.',
    items: featuredItems,
  },
  {
    id: 'workplace',
    label: 'Production roles',
    intro: 'Full-time and contract roles shown separately from project builds.',
    items: workplaceItems,
  },
  {
    id: 'earlier',
    label: 'Earlier projects',
    intro: 'Archived Laravel, PHP, and web/mobile practice projects kept as one compact entry.',
    items: earlierItems,
  },
  {
    id: 'recurring',
    label: 'Recurring capabilities',
    intro:
      'Support work that often sits inside delivery: WordPress, analytics, performance, backups, and automation.',
    items: recurringItems,
  },
].filter((group) => group.items.length > 0);

const totalCount = groups.reduce((count, group) => count + group.items.length, 0);
---

<BaseLayout
  title="Work"
  description="Selected work across web applications, content platforms, SEO, automation, and production roles."
>
  <section class="container work-page" aria-labelledby="work-title">
    <p class="label work-page__eyebrow">Selected work · {totalCount} entries</p>
    <h1 id="work-title">Web apps, automation, and production roles.</h1>
    <p class="work-page__intro">
      A curated view of project builds and workplace experience across Laravel, PHP, WordPress,
      Next.js, SEO, APIs, and practical AI-assisted workflows.
    </p>

    {
      groups.map((group) => (
        <div class={`work-page__group work-page__group--${group.id}`}>
          <header class="work-page__group-header">
            <h2 class="work-page__group-title">{group.label}</h2>
            <p class="work-page__group-intro">{group.intro}</p>
          </header>
          <div class="work-page__list">
            {group.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-xl);
  }
  .work-page__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .work-page h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 24ch;
  }
  .work-page__intro {
    margin: 0;
    max-width: 60ch;
    color: var(--soft-ink);
  }
  .work-page__group {
    display: grid;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .work-page__group-header {
    display: grid;
    gap: 0.35rem;
  }
  @media (min-width: 820px) {
    .work-page__group-header {
      grid-template-columns: minmax(0, 0.45fr) minmax(0, 0.75fr);
      align-items: end;
    }
  }
  .work-page__group-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .work-page__group-intro {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-longform);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--soft-ink);
  }
  .work-page__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
  .work-page__group--earlier .work-page__list,
  .work-page__group--recurring .work-page__list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
</style>
