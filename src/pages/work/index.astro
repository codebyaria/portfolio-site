---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

type Category = 'workplace' | 'project' | 'recurring';

const all = await getCollection('work');

const workplaceItems = all
  .filter((p) => p.data.category === 'workplace')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const projectItems = all
  .filter((p) => p.data.category === 'project' && p.data.classification !== 'client-work')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const groups: { id: Category; label: string; intro: string; items: typeof all }[] = [
  {
    id: 'project',
    label: 'Featured builds',
    intro:
      'Modern web, CMS/API, automation, and dashboard work — kept to the pieces worth opening first.',
    items: projectItems,
  },
  {
    id: 'workplace',
    label: 'Workplaces',
    intro: 'Full-time and contract roles, shown as a compact career timeline.',
    items: workplaceItems,
  },
];

const totalCount = groups.reduce((count, group) => count + group.items.length, 0);
---

<BaseLayout
  title="Work"
  description="Selected work, classified by evidence status and grouped by category. No fabricated outcomes."
>
  <section class="container work-page" aria-labelledby="work-title">
    <p class="label work-page__eyebrow">Selected work · {totalCount} entries</p>
    <h1 id="work-title">A shorter path through the work.</h1>
    <p class="work-page__intro">
      Start with the strongest builds, then scan the workplace timeline. Recurring skills stay on
      the homepage so this page does not turn into a long archive.
    </p>

    {
      groups.map((group) => (
        <div class="work-page__group">
          <header class="work-page__group-header">
            <h2 class="work-page__group-title">{group.label}</h2>
            <p class="work-page__group-intro">{group.intro}</p>
          </header>
          <div class="work-page__list">
            {group.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-xl);
  }
  .work-page__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .work-page h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 24ch;
  }
  .work-page__intro {
    margin: 0;
    max-width: 60ch;
    color: var(--soft-ink);
  }
  .work-page__group {
    display: grid;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .work-page__group-header {
    display: grid;
    gap: 0.35rem;
  }
  .work-page__group-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .work-page__group-intro {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-longform);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--soft-ink);
  }
  .work-page__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
</style>
