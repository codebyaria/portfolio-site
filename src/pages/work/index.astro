---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

type Category = 'workplace' | 'project' | 'recurring';

const all = await getCollection('work');

const groups: { id: Category; label: string; intro: string; items: typeof all }[] = [
  {
    id: 'workplace',
    label: 'Journey',
    intro: 'Full-time and contract roles — real production systems shipped with accountability.',
    items: all.filter((p) => p.data.category === 'workplace'),
  },
  {
    id: 'project',
    label: 'Selected Work',
    intro: 'Project-level deliverables — portfolio demos, concept work, in-development pieces.',
    items: all.filter((p) => p.data.category === 'project'),
  },
  {
    id: 'recurring',
    label: 'Ongoing Practice',
    intro: 'Recurring patterns of work across multiple engagements — no single deliverable.',
    items: all.filter((p) => p.data.category === 'recurring'),
  },
];

const totalCount = all.length;
---

<BaseLayout
  title="Work"
  description="Selected work, classified by evidence status and grouped by category. No fabricated outcomes."
>
  <section class="container work-page" aria-labelledby="work-title">
    <p class="label work-page__eyebrow">Selected work · {totalCount} entries</p>
    <h1 id="work-title">What I have been building</h1>
    <p class="work-page__intro">
      Each entry is classified. Grouped below by category — workplace roles, project deliverables,
      and recurring practice patterns stay distinct. No metric, client outcome, or screenshot
      appears here until evidence review confirms it.
    </p>

    {
      groups.map((group) => (
        <div class="work-page__group">
          <header class="work-page__group-header">
            <h2 class="work-page__group-title">{group.label}</h2>
            <p class="work-page__group-intro">{group.intro}</p>
          </header>
          <div class="work-page__list">
            {group.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .work-page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-xl);
  }
  .work-page__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .work-page h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 24ch;
  }
  .work-page__intro {
    margin: 0;
    max-width: 60ch;
    color: var(--soft-ink);
  }
  .work-page__group {
    display: grid;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .work-page__group-header {
    display: grid;
    gap: 0.35rem;
  }
  .work-page__group-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .work-page__group-intro {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-longform);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--soft-ink);
  }
  .work-page__list {
    border-top: 1px solid var(--line);
    margin-top: var(--space-md);
  }
</style>
