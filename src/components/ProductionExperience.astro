---
/**
 * Production Experience section (PRD 5.5).
 *
 * Surfaces the claim that the candidate has worked on real professional
 * systems, separate from the portfolio demos. Until verified facts exist,
 * the section is a placeholder honesty card explaining what will go here
 * and why nothing is published yet.
 */
---

<section class="production container" aria-labelledby="production-title" data-state="pending-facts">
  <p class="label production__eyebrow">Production Experience</p>
  <h2 id="production-title">Real professional work, separate from the demos.</h2>
  <p class="production__lead">
    Real work shipped and maintained in professional settings — separate from the demos.
  </p>

  <ul class="production__cards" role="list">
    <li class="production__card">
      <a href="/work/nongsa-sez/">
        <span class="production__card-glyph" aria-hidden="true">◌</span>
        <span class="production__card-name">Nongsa SEZ</span>
        <span class="production__card-meta">Sep 2021 – Jan 2022 · Mobile and Cloud Developer</span>
        <span class="production__card-tag">Production</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/hasnur-centre/">
        <span class="production__card-glyph" aria-hidden="true">▣</span>
        <span class="production__card-name">Hasnur Centre · Guruinovatif.id</span>
        <span class="production__card-meta">Aug 2022 – Jan 2024 · Web Developer</span>
        <span class="production__card-tag">Production</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/object-expression-sdn-bhd/">
        <span class="production__card-glyph" aria-hidden="true">◈</span>
        <span class="production__card-name">Object Expression Sdn. Bhd.</span>
        <span class="production__card-meta">Jan 2024 – Mar 2025 · Fullstack Developer</span>
        <span class="production__card-tag">Production</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/merdeka-ai/">
        <span class="production__card-glyph" aria-hidden="true">✦</span>
        <span class="production__card-name">Merdeka-AI</span>
        <span class="production__card-meta">Jan 2025 – Present · Fullstack Developer</span>
        <span class="production__card-tag">Production</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/wordpress-client-work/">
        <span class="production__card-glyph" aria-hidden="true">▤</span>
        <span class="production__card-name">WordPress Client Work</span>
        <span class="production__card-meta">Ongoing · WordPress Developer</span>
        <span class="production__card-tag">Client work</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/analytics-integrations/">
        <span class="production__card-glyph" aria-hidden="true">◍</span>
        <span class="production__card-name">Analytics Integrations</span>
        <span class="production__card-meta">Ongoing · GA4 · GSC · Pixel · Clarity · Hotjar</span>
        <span class="production__card-tag">Cross-project</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/security-performance-backup/">
        <span class="production__card-glyph" aria-hidden="true">▥</span>
        <span class="production__card-name">Security · Performance · Backup</span>
        <span class="production__card-meta">Ongoing · Hardening · Optimisation · Restore</span>
        <span class="production__card-tag">Cross-project</span>
      </a>
    </li>
    <li class="production__card">
      <a href="/work/n8n-automations/">
        <span class="production__card-glyph" aria-hidden="true">⇄</span>
        <span class="production__card-name">n8n Automations</span>
        <span class="production__card-meta">Ongoing · Form-to-DB · Email-to-task · Scraper</span>
        <span class="production__card-tag">Personal</span>
      </a>
    </li>
  </ul>

  <aside class="production__notice" role="status">
    <p class="label production__notice-label">Honesty notice</p>
    <p class="production__notice-body">
      <strong>Production claims are bounded by evidence.</strong>
      The eight entries below are published with generic descriptions and explicit "pending evidence"
      markers wherever a metric is not isolated to this contribution. Per PRD 10.2, no confidential code,
      credentials, customer data, proprietary architecture, or internal business information appears here.
      Per the project's honesty rules, anything unverified is marked pending rather than removed silently.
    </p>
  </aside>

  <p class="production__brief">
    Every entry is bounded by evidence: specific metrics are marked
    <em>Pending evidence</em> rather than rounded up; no confidential code, credentials, customer data,
    or proprietary architecture appears. Per the project's honesty rules.
  </p>
</section>

<style>
  .production {
    padding-block: clamp(2.5rem, 7vw, 6rem);
    display: grid;
    gap: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .production__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .production h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 28ch;
  }
  .production__lead {
    margin: 0;
    max-width: 56ch;
    font-family: var(--font-longform);
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .production__lead + .production__lead {
    margin-top: calc(-1 * var(--space-sm));
  }
  .production__inline-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    font-weight: 600;
  }
  .production__inline-link:hover,
  .production__inline-link:focus-visible {
    border-bottom-color: transparent;
  }
  .production__notice {
    margin: 0;
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--caution);
    background: var(--surface);
  }
  .production__notice-label {
    color: var(--caution);
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }
  .production__notice-body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .production__notice-body strong {
    color: var(--caution);
  }
  .production__notice-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper);
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
  }
  /* Card grid (visual entry list, replaces long lead paragraph) */
  .production__cards {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .production__card {
    margin: 0;
  }
  .production__card a {
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 0.45rem;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    border-radius: 3px;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
    min-height: 8.5rem;
  }
  .production__card a:hover,
  .production__card a:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .production__card-glyph {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }
  .production__card-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .production__card-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--soft-ink);
    line-height: 1.4;
  }
  .production__card-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    align-self: end;
  }
  .production__brief {
    margin: var(--space-md) 0 0;
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--soft-ink);
  }
  .production__brief em {
    font-style: italic;
    color: var(--caution);
  }
</style>
