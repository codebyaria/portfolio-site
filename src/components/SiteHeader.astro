---
interface Props {
  lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
const isId = lang === 'id';
const prefix = isId ? '/id' : '';
const links = [
  { href: `${prefix}/`, label: isId ? 'Beranda' : 'Home' },
  { href: `${prefix}/work/`, label: isId ? 'Karya' : 'Work' },
  { href: `${prefix}/about/`, label: isId ? 'Tentang' : 'About' },
  { href: `${prefix}/contact/`, label: isId ? 'Kontak' : 'Contact' },
];
const languageLinks = [
  { href: '/', label: 'EN', current: !isId },
  { href: '/id/', label: 'ID', current: isId },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__mark" href={isId ? '/id/' : '/'} aria-label="Aria Nurhadi Zain home">
      <picture class="site-header__logo">
        <source srcset="/images/aria-logo.webp" type="image/webp" />
        <img src="/images/aria-logo.png" alt="" width="512" height="251" decoding="async" />
      </picture>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="site-header__language" aria-label="Language">
      <ul>
        {
          languageLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-header__meta">
      <span>Full-time · Remote</span>
      <span
        >{isId ? 'Sukoharjo, Jawa Tengah, Indonesia' : 'Sukoharjo, Central Java, Indonesia'}</span
      >
    </p>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .site-header__row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-height: 76px;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .site-header__logo {
    display: block;
    width: clamp(7rem, 11vw, 9rem);
    line-height: 0;
  }
  .site-header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .site-header__nav ul,
  .site-header__language ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .site-header__nav ul {
    gap: 0.25rem 1.5rem;
    justify-content: center;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    font-weight: 700;
  }
  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .site-header__language ul {
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .site-header__language a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    padding-inline: 0.45rem;
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--soft-ink);
    font-weight: 700;
  }
  .site-header__language a[aria-current='page'] {
    border-color: var(--line);
    color: var(--ink);
  }
  .site-header__meta {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--soft-ink);
  }
  @media (max-width: 980px) {
    .site-header__row {
      grid-template-columns: auto 1fr auto;
    }
    .site-header__meta {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
  @media (max-width: 620px) {
    .site-header__row {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-sm);
    }
    .site-header__nav {
      grid-column: 1 / -1;
    }
    .site-header__nav ul {
      justify-content: flex-start;
    }
  }
</style>
