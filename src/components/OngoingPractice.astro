---
/**
 * Ongoing Practice section — recurring work patterns, no single deliverable.
 *
 * Three recurring entries: Analytics Integrations, Security / Performance /
 * Backup, and n8n Automations. These are capability patterns, not the
 * main workplace timeline.
 *
 * Hard-coded card data (matches ProductionExperience.astro card grid).
 */
const entries = [
  {
    slug: 'analytics-integrations',
    name: 'Analytics Integrations',
    meta: 'Ongoing · GA4 · GSC · Meta Pixel · Clarity · Hotjar · GTM',
    tag: 'Cross-project',
    glyph: '◍',
  },
  {
    slug: 'security-performance-backup',
    name: 'Security · Performance · Backup',
    meta: 'Ongoing · Hardening · Optimisation · Restore',
    tag: 'Cross-project',
    glyph: '▥',
  },
  {
    slug: 'n8n-automations',
    name: 'n8n Automations',
    meta: 'Ongoing · Form-to-DB · Email-to-task · Scraper-to-Notion',
    tag: 'Personal',
    glyph: '⇄',
  },
];
---

<section class="practice container" aria-labelledby="practice-title">
  <p class="practice__eyebrow label">Ongoing Practice</p>
  <h2 id="practice-title" class="practice__title">Recurring work patterns</h2>
  <p class="practice__lead">
    Practices I keep running across projects — no single deliverable, but real work that ships
    repeatedly.
  </p>

  <ul class="practice__cards" role="list">
    {
      entries.map((entry) => (
        <li class="practice__card">
          <a href={`/work/${entry.slug}/`}>
            <span class="practice__card-glyph" aria-hidden="true">
              {entry.glyph}
            </span>
            <span class="practice__card-name">{entry.name}</span>
            <span class="practice__card-meta">{entry.meta}</span>
            <span class="practice__card-tag">{entry.tag}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .practice {
    padding-block: clamp(2.5rem, 7vw, 6rem);
    display: grid;
    gap: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .practice__eyebrow {
    color: var(--accent);
    margin: 0;
  }
  .practice__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 28ch;
  }
  .practice__lead {
    margin: 0;
    max-width: 56ch;
    font-family: var(--font-longform);
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--soft-ink);
  }

  .practice__cards {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .practice__card {
    margin: 0;
  }
  .practice__card a {
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 0.45rem;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    border-radius: 3px;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
    min-height: 8.5rem;
  }
  .practice__card a:hover,
  .practice__card a:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .practice__card-glyph {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }
  .practice__card-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .practice__card-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--soft-ink);
    line-height: 1.4;
  }
  .practice__card-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    align-self: end;
  }
  .practice__brief {
    margin: var(--space-md) 0 0;
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--soft-ink);
  }
  .practice__brief em {
    font-style: italic;
    color: var(--caution);
  }
</style>
