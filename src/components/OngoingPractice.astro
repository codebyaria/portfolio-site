---
const entries = [
  {
    slug: 'analytics-integrations',
    name: 'Analytics setup',
    meta: 'GA4 · GSC · GTM · pixels · Clarity',
  },
  {
    slug: 'security-performance-backup',
    name: 'Performance and maintenance',
    meta: 'Hardening · speed checks · backup/restore',
  },
  {
    slug: 'n8n-automations',
    name: 'Workflow automation',
    meta: 'n8n · webhooks · APIs · handoff flows',
  },
  {
    slug: 'wordpress-client-work',
    name: 'WordPress delivery',
    meta: 'Elementor · PHP/MySQL · hosting handoff',
  },
];
---

<section class="practice container" aria-labelledby="practice-title">
  <div class="practice__header">
    <div>
      <p class="practice__eyebrow label">Recurring capabilities</p>
      <h2 id="practice-title" class="practice__title">Useful work that repeats across projects.</h2>
    </div>
    <p class="practice__lead">
      These are supporting delivery skills, kept compact so the main portfolio stays focused on
      project builds and production roles.
    </p>
  </div>

  <ul class="practice__list" role="list">
    {
      entries.map((entry) => (
        <li class="practice__item">
          <a href={`/work/${entry.slug}/`}>
            <span class="practice__item-name">{entry.name}</span>
            <span class="practice__item-meta">{entry.meta}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .practice {
    padding-block: clamp(2.25rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .practice__header {
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 820px) {
    .practice__header {
      grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 0.75fr);
      align-items: end;
    }
  }
  .practice__eyebrow {
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .practice__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .practice__lead {
    margin: 0;
    color: var(--soft-ink);
    line-height: 1.55;
  }
  .practice__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .practice__item {
    border-bottom: 1px solid var(--line);
  }
  .practice__item a {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 700px) {
    .practice__item a {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .practice__item a:hover .practice__item-name,
  .practice__item a:focus-visible .practice__item-name {
    color: var(--accent);
  }
  .practice__item-name {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .practice__item-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--soft-ink);
    line-height: 1.45;
  }
</style>
