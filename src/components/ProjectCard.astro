---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const categoryLabels = {
  workplace: 'Workplace',
  project: 'Build',
  recurring: 'Practice',
} as const;
---

<article class="project-card" data-category={project.data.category}>
  <p class="project-card__kicker label">{categoryLabels[project.data.category]}</p>
  <Heading class="project-card__title">
    <a href={`/work/${project.data.slug}/`}>{project.data.title}</a>
  </Heading>
  <p class="project-card__summary">{project.data.summary}</p>
  <p class="project-card__meta">
    <span>{project.data.role}</span>
    <span aria-hidden="true">·</span>
    <span>{project.data.stack.slice(0, 3).join(' · ')}</span>
  </p>
</article>

<style>
  .project-card {
    display: grid;
    gap: 0.65rem;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--line);
    background: var(--paper);
    min-height: 13rem;
  }
  .project-card__kicker {
    margin: 0;
    color: var(--accent);
  }
  .project-card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .project-card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .project-card__title a:hover,
  .project-card__title a:focus-visible {
    color: var(--accent);
  }
  .project-card__summary {
    margin: 0;
    color: var(--soft-ink);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-card__meta {
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: var(--space-xs) 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--soft-ink);
  }
</style>
