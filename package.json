{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:screenshots": "node scripts/capture-mobile-screenshots.mjs",
    "audit:lighthouse": "lhci collect --config=lighthouserc.json && lhci upload --target=filesystem --output-path=./lighthouse-report"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "pnpm": {
    "overrides": {
      "typescript": ">=6.0.0 <7.0.0"
    }
  },
  "eslintConfig": {}
}
